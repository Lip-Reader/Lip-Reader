{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "chaplin-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "app",
        "run",
        "web"
      ],
      "port": 5173
    },
    {
      "name": "chaplin-api",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "uvicorn",
        "backend.app.main:app",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "chaplin-vsr",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "uvicorn",
        "backend.app.vsr_main:app",
        "--port",
        "8001"
      ],
      "port": 8001
    }
  ]
}
