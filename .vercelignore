# Vercel hosts the SPA (app/) + the lightweight API backend (api/index.py ->
# backend/app, no VSR). The GPU vsr_lip_reader service runs on Modal.
.env
app/.env
.venv
.claude
.pytest_cache
app/node_modules
app/.env.local
app/e2e
app/playwright.config.ts
app/screenshots
app/test-results
app/.expo

# Local/uv dependency manifests list torch etc. — Vercel must resolve deps
# from requirements.txt instead, or the function blows the 500MB limit.
pyproject.toml
uv.lock

# GPU/VSR code — lives in the Modal vsr_lip_reader service, never on Vercel.
backend/espnet
backend/pipelines
backend/app/vsr_main.py
backend/app/vsr.py
backend/storage
backend/e2e_check.py
modal_app.py
benchmarks

# Not needed by the deployment.
tests
spec
assets/sravi_test_videos
assets/test_videos
assets/chaplin_ai.pptx
project_requierments.pdf
*.mp4
*.mov
