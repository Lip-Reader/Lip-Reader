{
  "name": "chaplin-ai-app",
  "version": "2.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web --port 5173",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "build": "expo export -p web",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.native.json",
    "e2e": "playwright test --project=guest --project=admin",
    "shots": "playwright test --project=shots"
  },
  "dependencies": {
    "@clerk/expo": "^4.6.8",
    "@expo/metro-runtime": "~57.0.15",
    "@expo/vector-icons": "^15.0.2",
    "expo": "~57.0.23",
    "expo-audio": "~57.0.5",
    "expo-blur": "~57.0.3",
    "expo-camera": "~57.0.5",
    "expo-constants": "~57.0.18",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
